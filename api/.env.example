# Chaîne de connexion MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:MOT_DE_PASSE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Nom de la base
MONGODB_DB=agenda_mmi
# Secret de signature des jetons : une longue chaîne aléatoire (ex. `openssl rand -hex 32`)
JWT_SECRET=change-moi
# Fuseau utilisé pour convertir les horaires Hyperplanning
CAL_TZ=Europe/Paris
# Import automatique d'Hyperplanning toutes les N minutes, et écart minimum entre deux imports
HP_REFRESH_MIN=10
HP_MIN_GAP_SEC=60
PORT=3000
